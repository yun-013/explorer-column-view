<Window x:Class="ColumnView.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColumnView"
        Title="操作履歴"
        Width="700" Height="620" MinWidth="460" MinHeight="320"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- 文字ボタン (ここまで戻す / 元に戻す など) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小さなアイコンボタン (詳細の開閉) -->
        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="詳細 (1 項目ずつの元の場所・移動先・今の状態)"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <local:Icon x:Name="Glyph" Glyph="&#xE76C;" FontSize="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Glyph" Value="&#xE70D;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 詳細の 1 項目 -->
        <DataTemplate DataType="{x:Type local:HistoryItemRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:Icon Glyph="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="12"
                            VerticalAlignment="Top" Margin="0,3,0,0" ToolTip="{Binding StatusText}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FromFull}">
                        <Run Text="元:"/> <Run Text="{Binding FromText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ToFull}">
                        <Run Text="先:"/> <Run Text="{Binding ToText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="11.5" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="表示" VerticalAlignment="Top"
                        Height="24" Padding="9,0" FontWeight="Normal"
                        ToolTip="今ある場所を列で開いて選択する"
                        Visibility="{Binding CanReveal, Converter={StaticResource B2V}}"
                        Tag="{Binding}" Click="Reveal_Click"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <!-- 見出しと全体の操作 -->
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="UndoButton" Style="{StaticResource PillButton}" Content="元に戻す"
                        ToolTip="直前の操作を 1 つ取り消す (Ctrl+Z)" Click="Undo_Click"/>
                <Button x:Name="RedoButton" Style="{StaticResource PillButton}" Content="やり直す"
                        ToolTip="取り消した操作を 1 つやり直す (Ctrl+Y)" Click="Redo_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="操作履歴" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Margin="0,3,12,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="新しい順に並んでいます。「ここまで戻す」を押すと、その操作までをまとめて取り消します。取り消した分は「ここまでやり直す」で元に戻せます。"/>
            </StackPanel>
        </DockPanel>

        <!-- 直近の結果 -->
        <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Margin="4,8,4,0" FontSize="12"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="EntryScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="EntryList" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HistoryEntry}">
                                <StackPanel>
                                    <!-- 区切り: 前回の起動までの操作 -->
                                    <DockPanel Margin="10,10,10,4"
                                               Visibility="{Binding ShowSessionMarker, Converter={StaticResource B2V}}">
                                        <TextBlock DockPanel.Dock="Left" Text="前回の起動までの操作" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                                        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <!-- 区切り: ここが今の状態 (上は取り消し済み) -->
                                    <DockPanel Margin="10,8,10,4"
                                               Visibility="{Binding ShowCurrentMarker, Converter={StaticResource B2V}}">
                                        <TextBlock DockPanel.Dock="Left" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="▼ ここが今の状態 (上は取り消し済み)"/>
                                        <Border Height="1" Background="{DynamicResource AccentDropBorderBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <Border x:Name="Row" CornerRadius="8" Padding="8,6,6,6" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <local:Icon Glyph="{Binding Glyph}" FontSize="15" VerticalAlignment="Top"
                                                        Margin="2,2,0,0" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Margin="10,1,12,0"
                                                       VerticalAlignment="Top" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock>
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding StateText, Mode=OneWay}" FontSize="11"
                                                         Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Summary}" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                            </StackPanel>
                                            <Button x:Name="StepButton" Grid.Column="3" Style="{StaticResource PillButton}"
                                                    Content="ここまで戻す" VerticalAlignment="Top" Tag="{Binding}"
                                                    Click="Step_Click" MouseEnter="Step_MouseEnter" MouseLeave="Step_MouseLeave"/>
                                            <ToggleButton Grid.Column="4" Style="{StaticResource ChevronToggle}"
                                                          VerticalAlignment="Top" Margin="2,0,0,0"
                                                          IsChecked="{Binding IsExpanded}" Checked="Expand_Checked"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="38,0,10,8"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="False">
                                        <Setter TargetName="StepButton" Property="Content" Value="ここまでやり直す"/>
                                        <Setter TargetName="Row" Property="Opacity" Value="0.62"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InRange}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDropHighlightBrush}"/>
                                        <Setter TargetName="Row" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="まだファイル操作の履歴はありません"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
