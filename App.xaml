<Application x:Class="ColumnView.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColumnView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <!-- ==== カラーパレット (Claude 風の温かみ×朱肉寄りのテラコッタアクセント) ==== -->
        <SolidColorBrush x:Key="AccentBrush" Color="#B4513A"/>
        <SolidColorBrush x:Key="AccentSelectBrush" Color="#1FD98038"/>
        <SolidColorBrush x:Key="AccentSelectHoverBrush" Color="#2BD98038"/>
        <!-- 選択中の行 (付箋) の先端: App.ApplyTheme が左端 4px だけ色の乗るブラシを作る -->
        <SolidColorBrush x:Key="NoteTipBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="AccentFocusBrush" Color="#1EB4513A"/>
        <SolidColorBrush x:Key="AccentCrumbHoverBrush" Color="#15B4513A"/>
        <SolidColorBrush x:Key="AccentDropHighlightBrush" Color="#2EB4513A"/>
        <SolidColorBrush x:Key="AccentDropBorderBrush" Color="#99B4513A"/>

        <!-- ドラッグ中のゴーストが「今ドロップしたら何が起きるか」を示す色。
             Copy = 緑 (元が残る)、Move = 青 (元が消える)。操作が未確定のときは
             アクセントのテラコッタを流用するので、この 2 色はアクセントと明確に別系統にする。
             Accent = 枠線とバッジ文字、Tint = バッジの塗り。 -->
        <SolidColorBrush x:Key="DropCopyAccentBrush" Color="#2E7D50"/>
        <SolidColorBrush x:Key="DropCopyTintBrush" Color="#1F2E7D50"/>
        <SolidColorBrush x:Key="DropMoveAccentBrush" Color="#2B6CB0"/>
        <SolidColorBrush x:Key="DropMoveTintBrush" Color="#1F2B6CB0"/>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FCFAF7"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFE"/>
        <SolidColorBrush x:Key="CaptionBarBrush" Color="#F1ECE2"/>
        <!-- タブをドラッグしてこのウィンドウに結合できる状態を示すタブ列の色 -->
        <SolidColorBrush x:Key="CaptionBarMergeBrush" Color="#E8CEBF"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#ECE7DD"/>
        <SolidColorBrush x:Key="WindowOuterBorderBrush" Color="#E3DCCF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A2622"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A8474"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#B6AFA0"/>

        <!-- ホバー等の半透明オーバーレイ (ダークテーマで白系に差し替わる) -->
        <SolidColorBrush x:Key="HoverOverlayBrush" Color="#12000000"/>
        <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1E000000"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#0D000000"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="ChipHoverBrush" Color="#F6F2EB"/>
        <SolidColorBrush x:Key="ChipPressedBrush" Color="#F1ECE2"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#30000000"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#55000000"/>

        <DropShadowEffect x:Key="SoftShadow" Color="#3A2A18" Opacity="0.14" BlurRadius="3" ShadowDepth="1.5" Direction="315"/>
        <DropShadowEffect x:Key="MenuShadow" Color="#3A2A18" Opacity="0.14" BlurRadius="3" ShadowDepth="1.5" Direction="315"/>
        <!-- 上に滲まないタイトな影 (タブ直下のツールバー用。ブラーが上の帯に掛かると線に見えるため) -->
        <DropShadowEffect x:Key="CardShadowBelow" Color="#3A2A18" Opacity="0.14" BlurRadius="3" ShadowDepth="1.5" Direction="315"/>
        <!-- さらに控えめな影 (カードの上に載る入力欄など、二重に影が掛かる場所用) -->
        <!-- タブ + 本体の紙: 同じ向きで少し大きめの影と、向きを持たない薄い接地影 (輪郭用) -->
        <DropShadowEffect x:Key="SheetShadow" Color="#3A2A18" Opacity="0.20" BlurRadius="5" ShadowDepth="3" Direction="315"/>
        <DropShadowEffect x:Key="SheetContactShadow" Color="#3A2A18" Opacity="0.14" BlurRadius="3" ShadowDepth="0" Direction="315"/>
        <!-- 選択中の行 (付箋) の影の色と濃さ (行ごとの影が参照する。形は NoteShadow と同じ) -->
        <Color x:Key="NoteShadowColor">#3A2A18</Color>
        <sys:Double x:Key="NoteShadowOpacity">0.17</sys:Double>
        <!-- 選択中の行 (付箋): 同じ向きで、他の紙より少しだけ浮いた影 -->
        <DropShadowEffect x:Key="NoteShadow" Color="#3A2A18" Opacity="0.17" BlurRadius="4" ShadowDepth="2.2" Direction="315"/>
        <DropShadowEffect x:Key="SubtleShadow" Color="#3A2A18" Opacity="0.14" BlurRadius="3" ShadowDepth="1.5" Direction="315"/>

        <!-- 字形 (Segoe のコードポイント文字列) を Content に持つボタン用: Icon で描く -->
        <DataTemplate x:Key="IconContent">
            <local:Icon Glyph="{Binding}"/>
        </DataTemplate>

        <!-- スリムな角丸スクロールバー (矢印なし・普段は細く、ホバーで少し太く) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecBtn" Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncBtn" Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="{DynamicResource ScrollThumbBrush}"
                                                        CornerRadius="3" Margin="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                        <Setter TargetName="Tb" Property="Margin" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                        <Setter TargetName="Tb" Property="Margin" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="DecBtn" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="IncBtn" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 現代的な角丸リスト行 (ホバー・選択ともに温色アクセント、選択時は左端にアクセントピル) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="5,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- 選択中の行はフィルム付箋に見立てる: 左端の色の濃い部分 (Pill) で貼られていて、
                                 右へ行くほど紙から浮く。影は左端ではほぼ出さず、右へ向かって濃くする
                                 (影の向き自体は他の紙と同じ右下)。OpacityMask の横グラデーションで影ごと薄める。
                                 行の Bd に直接影を掛けると文字まで影を持つため、影は中身の無い要素に掛け、
                                 その上に影なしの台紙 (Lift) を重ねて行の内側に落ちた影を隠す。
                                 選択中の行 (表示中の数行) にしか出ない。
                                 影は貼る瞬間の演出で動かすため、共有リソースではなく行ごとの DropShadowEffect を持つ
                                 (色と濃さはテーマのリソース。形は NoteShadow と同じ値で落ち着く) -->
                            <Grid x:Name="NoteCaster" Visibility="Collapsed" IsHitTestVisible="False">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="Transparent" Offset="0.08"/>
                                        <GradientStop Color="Black" Offset="0.7"/>
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border x:Name="NotePaper" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource NoteShadowColor}"
                                                          Opacity="{DynamicResource NoteShadowOpacity}"
                                                          BlurRadius="4" ShadowDepth="2.2" Direction="315"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <Border x:Name="Lift" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                            <!-- ホバーの下地: インクが紙に染みるように、切り替えずに不透明度をじわっと上げる。
                                 動くのはマウスが出入りした行の不透明度 1 つだけ (0.1 秒程度) なので軽い -->
                            <Border x:Name="Hover" Background="{DynamicResource RowHoverBrush}" CornerRadius="8"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <!-- 付箋の色の付いた先端 (ここで貼られている)。行と同じ角丸の面に、左端 4px だけ色が乗る
                                 ブラシ (NoteTipBrush) を塗る: 左は角丸のまま、右は真っすぐの端になる -->
                            <Border x:Name="Pill" CornerRadius="8" Background="{DynamicResource NoteTipBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Lift" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NoteCaster" Property="Visibility" Value="Visible"/>
                                <!-- 選択中のホバーは下の MultiTrigger の色で表す (下地を重ねると濁るため隠す) -->
                                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                                <!-- 付箋を貼る瞬間: 少し浮いていた付箋が紙に着地する。影が「遠く・大きく・ぼやけて・薄い」状態から
                                     約 0.35 秒で紙に着いた落ち着いた影に収まる (動くのは選んだ行の影 1 つだけ) -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NotePaper"
                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                             From="7" To="2.2" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NotePaper"
                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                             From="12" To="4" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NoteCaster" Storyboard.TargetProperty="Opacity"
                                                             From="0.35" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectHoverBrush}"/>
                            </MultiTrigger>
                            <!-- ドラッグ中のドロップ先フォルダ -->
                            <Trigger Property="local:DragDropHelper.DropHighlight" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDropHighlightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDropBorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <!-- お気に入り並べ替え: 挿入位置を線で示す -->
                            <Trigger Property="local:DragDropHelper.DropInsert" Value="Before">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,2,0,0"/>
                            </Trigger>
                            <Trigger Property="local:DragDropHelper.DropInsert" Value="After">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ドロップダウンの選択肢 (ソート基準など) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentCrumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- アプリ独自のポップアップメニュー (グループ管理など。シェルの右クリックメニューは OS 描画のため対象外) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="4" Margin="6"
                                Effect="{DynamicResource MenuShadow}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon x:Name="CheckMark" Grid.Column="0"
                                           FontSize="11" Glyph="&#xE73E;" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="18,0,0,0" VerticalAlignment="Center"/>
                                <local:Icon x:Name="Arrow" Grid.Column="2" FontSize="9"
                                           Glyph="&#xE76C;" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-8"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="4" Margin="6"
                                            Effect="{DynamicResource MenuShadow}">
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentCrumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ツールチップも角丸カードに -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="6"
                                Effect="{DynamicResource MenuShadow}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
